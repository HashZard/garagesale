# 站点
NEXT_PUBLIC_SITE_URL=https://garagesale.com.au

# Supabase：URL 与 Publishable key 可公开；Secret key 仅限服务端
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=sb_secret_example

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.example-mapbox-token
MAPBOX_SERVER_TOKEN=pk.example-server-only-mapbox-token

# Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=example-turnstile-site-key
TURNSTILE_SECRET_KEY=example-turnstile-secret-key

# Cloudflare Web Analytics
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=example-analytics-token

# 邮件
RESEND_API_KEY=re_example
RESEND_FROM_EMAIL=GarageSale <hello@example.com>

# 后台
ADMIN_SECRET=replace-with-at-least-32-random-characters
